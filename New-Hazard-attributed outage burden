def load_mcc(path):

    m = pd.read_csv(path)

    m.columns = [
        c.strip()
        for c in m.columns
    ]

    fc = (
        "County_FIPS"
        if "County_FIPS" in m.columns
        else m.columns[0]
    )

    cc = (
        "Customers"
        if "Customers" in m.columns
        else m.columns[1]
    )

    m[cc] = pd.to_numeric(
        m[cc],
        errors="coerce",
    )

    fn = pd.to_numeric(
        m[fc],
        errors="coerce",
    )

    m = m[
        fn.notna()
        & m[cc].notna()
    ]

    return dict(
        zip(
            fn[
                fn.notna()
            ]
            .astype("int64")
            .astype(str)
            .str.zfill(5),

            m[cc],
        )
    )


# ============================================================
# GINI
# ============================================================

def gini(v):

    v = np.sort(
        np.asarray(v, float)
    )

    v = v[v >= 0]

    if (
        v.size == 0
        or v.sum() == 0
    ):
        return np.nan

    n = v.size

    cum = np.cumsum(v)

    return (
        n
        + 1
        - 2
        * (
            cum / cum[-1]
        ).sum()
    ) / n


# ============================================================
# CONCENTRATION STATISTICS
# ============================================================

def conc_stats(v):

    v = np.sort(
        np.asarray(v, float)
    )[::-1]

    v = v[v > 0]

    if v.size == 0:
        return None

    tot = v.sum()

    n = v.size

    top = lambda f: (
        v[
            :max(
                1,
                int(
                    np.ceil(
                        f * n
                    )
                ),
            )
        ].sum()
        / tot
        * 100
    )

    cum = (
        np.cumsum(v)
        / tot
    )

    k50 = min(
        int(
            np.searchsorted(
                cum,
                0.5,
            )
            + 1
        ),
        n,
    )

    return {

        "n_counties": n,

        "gini": round(
            gini(v),
            4,
        ),

        "top1pct_share": round(
            top(0.01),
            2,
        ),

        "top5pct_share": round(
            top(0.05),
            2,
        ),

        "top10pct_share": round(
            top(0.10),
            2,
        ),

        "counties_to_50pct": k50,
    }


