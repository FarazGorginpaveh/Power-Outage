# ============================================================
# DOMINANT HAZARD FUNCTION
# ============================================================

def dominant(g):

    piv = g.pivot_table(

        index="county_fips",

        columns="hazard",

        values="abs_burden",

        aggfunc="sum",
    )

    for h in HAZARDS:

        if h not in piv.columns:

            piv[h] = np.nan

    return (

        piv[
            HAZARDS
        ]

        .idxmax(
            axis=1
        )

        .rename(
            "dominant"
        )

        .reset_index()

        .dropna(
            subset=[
                "dominant"
            ]
        )
    )


