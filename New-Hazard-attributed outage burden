# BOOLEAN HELPER
# ============================================================

def truthy(s):

    return (
        s
        .astype(str)
        .str.lower()
        .isin(
            [
                "true",
                "1",
                "1.0",
                "yes",
                "t",
            ]
        )
    )


# ============================================================
# ATTRIBUTE OUTAGE TO NEAREST STORM
# ============================================================

def attribute(
    o_df,
    buffer_hr,
):

    buf = np.timedelta64(
        buffer_hr,
        "h",
    )

    haz = np.array(
        [None] * len(o_df),
        dtype=object,
    )

    pos = {
        ix: i
        for i, ix
        in enumerate(
            o_df.index
        )
    }

    for c, og in o_df.groupby(
        "county_fips"
    ):

        sg = storms_by_c.get(c)

        if (
            sg is None
            or len(sg) == 0
        ):
            continue

        ss = (
            sg["s_start"]
            .values
            .astype(
                "datetime64[ns]"
            )
        )

        se = (
            sg["s_end"]
            .values
            .astype(
                "datetime64[ns]"
            )
        )

        sh = (
            sg["hazard"]
            .values
        )

        peaks = (
            og["peak_dt"]
            .values
            .astype(
                "datetime64[ns]"
            )
        )

        loc = [
            pos[ix]
            for ix
            in og.index
        ]

        ch = max(
            1,
            min(
                4000,
                int(
                    2_000_000
                    / max(
                        1,
                        len(sg),
                    )
                ),
            ),
        )

        for i in range(
            0,
            len(peaks),
            ch,
        ):

            P = peaks[
                i:i + ch
            ][:, None]

            dist = np.maximum(

                np.maximum(
                    ss[None, :]
                    - P,

                    P
                    - se[None, :],
                ),

                np.timedelta64(
                    0,
                    "ns",
                ),
            )

            within = (
                dist <= buf
            )

            df_ = (
                dist
                .astype(
                    "timedelta64[s]"
                )
                .astype(float)
            )

            df_[
                ~within
            ] = np.inf

            j = df_.argmin(
                axis=1
            )

            any_ = within.any(
                axis=1
            )

            sel = np.where(
                any_,
                sh[j],
                None,
            )

            for r, val in enumerate(
                sel
            ):

                haz[
                    loc[i + r]
                ] = val

    return pd.Series(
        haz,
        index=o_df.index,
    )


# ============================================================
# COUNTY-LEVEL HAZARD BURDEN
# ============================================================

def hazard_county(
    buffer_hr
):

    o = outs[
        truthy(
            outs[
                f"storm_linked_{buffer_hr}h"
            ]
        )
    ].copy()

    o["hazard"] = attribute(
        o,
        buffer_hr,
    )

    o = o[
        o["hazard"]
        .isin(
            HAZARDS
        )
    ]

    return (
        o
        .groupby(
            [
                "county_fips",
                "hazard",
            ]
        )["auc"]
        .sum()
        .rename(
            "abs_burden"
        )
        .reset_index()
    )


